CONFIG_IDF_TARGET="esp32s3"
# AP+STA LDN-host feasibility test needs SoftAP (hostapd's AP-mode code, esp_netif_create_default_wifi_ap).
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
# Dev board wired through its CH343 UART bridge (the native USB port isn't attached on the bench VM): console on UART0.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=n
# the Pia leader wants a <=5 ms loop; the default 100 Hz tick gives 10 ms.
CONFIG_FREERTOS_HZ=1000
# the S3 board has 8 MB octal PSRAM (esptool: "Embedded PSRAM 8MB (AP_3v3)") -- Bluetooth (~52 KB) plus the hosted
# trade room and Pia stack (~50 KB) do not fit in ~96 KB of internal heap. Big/long-lived buffers go to PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# the shared C3 trim of 16 static TX buffers leaves the S3's hosted trade short of TX buffers when Bluetooth delays the
# radio (58 of ~7000 sends failed ENOMEM). Static TX buffers are INTERNAL RAM even with PSRAM (64 of them left Bluetooth's
# controller unable to initialise), so only a modest increase is affordable; Espressif's Kconfig forbids the dynamic type here.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=24
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
